PORT=3001
# Interface the API listens on. Local-only by default; the browser reaches it through the Vite proxy.
HOST=127.0.0.1
# SQLite file (default data/gold.db)
DB_PATH=data/gold.db

# API keys below can also be entered in Settings → API keys (encrypted in the DB with
# the machine key in data/secret.key, or SECRET_KEY_PATH). A key saved there wins over .env.

# Databento — CME GLBX.MDP3 contract history (GC, MGC, SI, SIL). Paid; every pull is cost-estimated first.
DATABENTO_API_KEY=
# Max USD a single Databento pull may cost without an explicit override
DATABENTO_BUDGET=1

# OpenRouter — AI analyst (use an ":online" model for web-sourced briefs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# FRED — macro series (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Optional: CFTC Socrata app token (raises COT rate limits)
CFTC_APP_TOKEN=
